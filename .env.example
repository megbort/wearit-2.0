NEXT_PUBLIC_GRAPHQL_URL=https://your-railway-url.railway.app/graphql

# For local backend testing, create a .env.local (gitignored) that overrides
# the above — e.g. NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# Restart the dev server after changing env vars (NEXT_PUBLIC_* are inlined at boot).
#
# Auth uses an httpOnly refresh cookie, so requests are sent with
# credentials: 'include'. The backend must respond with
# Access-Control-Allow-Credentials: true and the exact frontend origin (not *),
# and cross-site cookies (frontend and API on different domains) need
# SameSite=None; Secure on the refresh cookie.
